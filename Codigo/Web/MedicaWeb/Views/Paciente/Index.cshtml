@using Core.Dto.Paciente
@model IEnumerable<PacienteDto>

@{
    ViewData["Title"] = "Pacientes";
}

<div class="calendario-container">
    <div class="table-header">
        <h2 class="titulo-sessao">Pacientes</h2>
        <a asp-controller="Paciente" asp-action="Create" class="btn-novo">Novo</a>
    </div>

    <table id="tabelaPacientes" class="custom-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>Sexo</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    var sexoFormatado = string.Equals(item.Sexo, "M")
                        ? "Masculino"
                        : "Feminino";

                    var statusFormatado = string.Equals(item.Ativo, "S")
                        ? "Ativo"
                        : "Inativo";

                    <tr onclick="location.href='@Url.Action("Details", "Paciente", new { id = item.Id })'" style="cursor:pointer;">
                        <td class="font-bold">@item.Nome</td>
                        <td>@(ulong.TryParse(item.Cpf, out var numCpf) ? numCpf.ToString(@"000\.000\.000\-00") : item.Cpf)</td>
                        <td>@sexoFormatado</td>
                        <td>@statusFormatado</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tabelaPacientes').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                "pageLength": 10,
                "searching": false,
                "info": false,
                "dom": 'rt<"bottom"lp><"clear">',
                "columnDefs": [
                    { "width": "40%", "targets": 0 },
                    { "width": "25%", "targets": 1 },
                    { "width": "20%", "targets": 2 },
                    { "width": "15%", "targets": 3 }
                ]
            });
        });
    </script>
}