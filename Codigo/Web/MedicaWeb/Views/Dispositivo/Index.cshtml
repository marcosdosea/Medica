@using Core.Dto.Dispositivo
@model IEnumerable<DispositivoDto>

@{
    ViewData["Title"] = "Associar Dispositivo";
}

<div class="calendario-container">
    <div class="table-header">
        <h2 class="titulo-sessao">Associar Dispositivo</h2>
    </div>

    <table id="tabelaDispositivos" class="custom-table">
        <thead>
            <tr>
                <th>Paciente</th>
                <th>Qtd. Dispositivos</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="font-bold">@item.NomePaciente</td>
                        <td>@item.QuantidadeDispositivos</td>
                        <td class="text-center">
                            <button type="button" class="btn-med btn-med-primary btn-sm d-inline-flex align-items-center gap-1 btn-associar"
                                    data-id="@item.IdPaciente"
                                    data-nome="@item.NomePaciente"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalAssociarDispositivo">
                                <i class="bi bi-phone"></i> Associar dispositivo
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalAssociarDispositivo" tabindex="-1" aria-labelledby="modalAssociarDispositivoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content text-center p-3">
            <div class="modal-header border-0 pb-0 justify-content-between">
                <h5 class="modal-title font-bold" id="modalAssociarDispositivoLabel">Associar dispositivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body py-4 d-flex flex-column align-items-center">
                <div id="qrcode" class="d-flex justify-content-center p-2 bg-white rounded border"></div>
                <p class="text-muted small mt-3 mb-0">Paciente: <strong id="modalNomePaciente"></strong></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tabelaDispositivos').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                "pageLength": 10,
                "searching": false,
                "info": false,
                "dom": 'rt<"bottom"lp><"clear">',
                "columnDefs": [
                    { "width": "50%", "targets": 0 },
                    { "width": "25%", "targets": 1 },
                    { "width": "25%", "targets": 2, "orderable": false, "className": "text-center" }
                ]
            });

            const modalEl = document.getElementById('modalAssociarDispositivo');
            let pacienteSelecionadoId = null;

            modalEl.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (button) {
                    pacienteSelecionadoId = button.getAttribute('data-id');
                    const nome = button.getAttribute('data-nome');
                    document.getElementById('modalNomePaciente').textContent = nome || '';
                }
            });

            modalEl.addEventListener('shown.bs.modal', function () {
                if (pacienteSelecionadoId) {
                    carregarQrCode(pacienteSelecionadoId);
                }
            });

            async function carregarQrCode(idPaciente) {
                const container = document.getElementById('qrcode');
                container.innerHTML = '<div class="d-flex flex-column align-items-center justify-content-center py-4"><div class="spinner-border text-primary mb-2" role="status"></div><span class="text-muted small">Gerando código seguro...</span></div>';

                try {
                    const url = '@Url.Action("ObterToken", "Dispositivo")' + '?id=' + idPaciente;
                    const response = await fetch(url, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) throw new Error('Falha ao obter token');
                    const data = await response.json();

                    if (data && data.token) {
                        container.innerHTML = '';
                        new QRCode(container, {
                            text: data.token,
                            width: 200,
                            height: 200,
                            colorDark: "#000000",
                            colorLight: "#ffffff",
                            correctLevel: QRCode.CorrectLevel.M
                        });
                    } else {
                        throw new Error('Token inválido');
                    }
                } catch (err) {
                    container.innerHTML = '<div class="d-flex flex-column align-items-center p-3 text-center"><div class="text-danger small mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Não foi possível conectar à MedicaApi.<br/>Verifique se o serviço está ativo.</div><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="carregarQrCode(' + idPaciente + ')"><i class="bi bi-arrow-clockwise"></i> Tentar novamente</button></div>';
                }
            }

            window.carregarQrCode = carregarQrCode;
        });
    </script>
}
