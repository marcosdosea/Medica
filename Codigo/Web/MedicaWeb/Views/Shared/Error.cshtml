@{
    ViewData["Title"] = "Erro";
    var errorMessage = ViewData["ErrorMessage"] as string ?? "Ocorreu um erro inesperado ao processar sua solicitação.";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 500px; border-radius: 12px; background: var(--bg-card, #ffffff);">
        <div class="mb-3">
            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 48px;"></i>
        </div>
        <h3 class="fw-bold mb-2" style="color: var(--primary, #000000);">Ops! Algo deu errado</h3>
        <p class="text-muted mb-4">@errorMessage</p>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 600;">
                <i class="bi bi-house-door me-1"></i> Voltar ao Início
            </a>
        </div>
    </div>
</div>
