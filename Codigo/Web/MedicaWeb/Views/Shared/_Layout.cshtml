<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medica</title>
    <link rel="icon" type="image/x-icon" href="~/icon.ico" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home/calendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/table/table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/form.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <header class="topbar">
        <div class="topbar-brand">
            <a class="topbar-title" asp-controller="Home" asp-action="Index">
                <span class="topbar-logo-wrapper">
                    <img src="~/img/logo.svg" alt="Logo Medica" class="topbar-logo" />
                </span>
                <span class="topbar-text">Medica</span>
            </a>
        </div>
    </header>
    <aside class="sidebar" id="sidebar">
        <button id="toggleSidebar" class="btn-floating-toggle">
            <i class="bi bi-chevron-left" id="toggleIcon"></i>
        </button>
        <nav class="nav-menu">
            @{
                var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
                var isCadastrosActive = controller == "Paciente" || controller == "Medicamento" || controller == "Planejamento";
                var isGerenciamentoActive = controller == "Cuidador" || controller == "Dispositivo";
            }

            <a class="nav-item @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i> <span>Início</span>
            </a>
            <div class="nav-group">
                <button class="nav-item nav-group-btn w-100 border-0 bg-transparent text-start @(isCadastrosActive ? "group-active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#menuCadastros" aria-expanded="true" aria-controls="menuCadastros">
                    <i class="bi bi-folder2-open"></i>
                    <span>Cadastros</span>
                    <i class="bi bi-chevron-down ms-auto chevron-icon"></i>
                </button>
                <div class="collapse show nav-sub-menu" id="menuCadastros">
                    <a class="nav-sub-item @(controller == "Paciente" ? "active" : "")" asp-controller="Paciente" asp-action="Index">
                        <i class="bi bi-person"></i> <span>Paciente</span>
                    </a>
                    <a class="nav-sub-item @(controller == "Medicamento" ? "active" : "")" asp-controller="Medicamento" asp-action="Index">
                        <i class="bi bi-clipboard-pulse"></i> <span>Medicamento</span>
                    </a>
                    <a class="nav-sub-item @(controller == "Planejamento" ? "active" : "")" asp-controller="Planejamento" asp-action="Create">
                        <i class="bi bi-calendar3"></i> <span>Planejamento</span>
                    </a>
                </div>
            </div>
            <div class="nav-group">
                <button class="nav-item nav-group-btn w-100 border-0 bg-transparent text-start @(isGerenciamentoActive ? "group-active" : "")"
                        type="button" data-bs-toggle="collapse" data-bs-target="#menuGerenciamento" aria-expanded="true" aria-controls="menuGerenciamento">
                    <i class="bi bi-sliders"></i>
                    <span>Gerenciamento</span>
                    <i class="bi bi-chevron-down ms-auto chevron-icon"></i>
                </button>
                <div class="collapse show nav-sub-menu" id="menuGerenciamento">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="nav-sub-item @(controller == "Cuidador" ? "active" : "")" asp-controller="Cuidador" asp-action="Index">
                            <i class="bi bi-people"></i> <span>Usuários</span>
                        </a>
                    }
                    <a class="nav-sub-item" href="#">
                        <i class="bi bi-bell"></i> <span>Notificações</span>
                    </a>
                    <a class="nav-sub-item @(controller == "Dispositivo" ? "active" : "")" asp-controller="Dispositivo" asp-action="Index">
                        <i class="bi bi-qr-code-scan"></i> <span>Associar Dispositivo</span>
                    </a>
                </div>
            </div>
        </nav>
        <footer class="sidebar-footer">
            <a class="nav-item mb-2 @(controller == "Configuracao" ? "active" : "")" href="#" title="Configuração">
                <i class="bi bi-gear"></i> <span>Configuração</span>
            </a>
            <form class="w-100" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="nav-item border-0 bg-transparent w-100 text-start text-inherit mb-2" title="Sair" style="cursor: pointer; font-family: inherit;">
                    <i class="bi bi-box-arrow-right"></i> <span>Sair</span>
                </button>
            </form>
            <div class="theme-switch">
                <button id="lightBtn" onclick="setTheme('light')"><i class="bi bi-sun"></i> Light</button>
                <button id="darkBtn" onclick="setTheme('dark')"><i class="bi bi-moon"></i> Dark</button>
            </div>
        </footer>
    </aside>
    <main class="main-wrapper">
        <div class="content-container">
            @RenderBody()
        </div>
        <footer class="content-footer"></footer>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/form/form.js" asp-append-version="true"></script>
    <script src="~/js/util/formatter-cpf.js" asp-append-version="true"></script>
    <partial name="_Notificacoes" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>