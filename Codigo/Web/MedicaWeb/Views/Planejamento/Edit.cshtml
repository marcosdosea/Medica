@model MedicaWeb.Models.PlanejamentoViewModel
@using Core.Enum.Planejamento
@using Util

@{
    ViewData["Title"] = "Editar Planejamento";
    var nomePaciente = ViewBag.NomePaciente as string ?? "Paciente";
    var isContinuo = Model.Continuo || Model.DataFim.Year > 9000;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/formPaciente.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/formPlanejamento.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        #formPlanejamentoEdit {
            padding-bottom: 140px !important;
        }
    </style>
}

<div class="header-inline mb-4 d-flex align-items-center gap-3">
    <a asp-action="Index" class="btn-voltar">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h2 style="margin: 0; font-weight: bold; font-size: 26px;">Editar planejamento</h2>
</div>

<form asp-action="Edit" method="post" id="formPlanejamentoEdit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IdPaciente" id="IdPaciente" />
    <input type="hidden" asp-for="DiaSemana" id="DiaSemana" />
    <input type="hidden" asp-for="Continuo" id="ContinuoHidden" value="@(isContinuo ? "true" : "false")" />
    <input type="hidden" asp-for="Ativo" />
    <input type="hidden" asp-for="Status" />

    <div class="secao-header mb-3" style="border:none; display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-person-fill" style="color: var(--text-muted); font-size: 20px;"></i>
        <span style="font-weight: 700; color: #495057; font-size: 18px;">Paciente</span>
    </div>

    <div class="cards-grid mb-4">
        <div class="paciente-card-wrapper">
            <div class="paciente-card" style="cursor: default;">
                <div class="foto-wrapper">
                    <i class="bi bi-person" style="font-size: 48px; color: var(--text-muted);"></i>
                </div>
                <div class="paciente-info">
                    <h3 class="paciente-nome" title="@nomePaciente">
                        @PacienteHelper.FormatarPrimeiroEUltimoNome(nomePaciente)
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="secao-header mb-3" style="border:none; display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-calendar3" style="color: var(--text-muted); font-size: 18px;"></i>
        <span style="font-weight: 700; color: #495057; font-size: 18px;">Dados do planejamento</span>
    </div>

    <div class="form-section mb-4">
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-3 form-group-custom">
                <label asp-for="IdMedicamento" class="label-custom">Medicamento</label>
                <select asp-for="IdMedicamento" class="form-input-custom" asp-items="ViewBag.Medicamentos" id="inputMedicamento">
                    <option value="">Selecione um medicamento</option>
                </select>
                <span asp-validation-for="IdMedicamento" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-3 form-group-custom">
                <label asp-for="DataInicio" class="label-custom">Data de início</label>
                <input asp-for="DataInicio" type="date" class="form-input-custom" id="inputDataInicio" />
                <span asp-validation-for="DataInicio" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-3 form-group-custom">
                <label asp-for="DataFim" class="label-custom">Data de fim</label>
                <input asp-for="DataFim" type="date" class="form-input-custom" id="inputDataFim" />
                <span asp-validation-for="DataFim" class="text-danger" style="font-size: 13px;" id="valDataFim"></span>
            </div>

            <div class="col-12 col-md-3 d-flex flex-column justify-content-center">
                <label class="label-custom">Planejamento contínuo?</label>
                <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                    <input class="form-check-input" type="checkbox" id="switchContinuo" @(isContinuo ? "checked" : "")>
                    <label class="form-check-label switch-label-text" id="txtContinuo" for="switchContinuo">@(isContinuo ? "Sim" : "Não")</label>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-2 form-group-custom">
                <label asp-for="Hora" class="label-custom">Hora de início</label>
                <input asp-for="Hora" type="time" class="form-input-custom" id="inputHora" />
                <span asp-validation-for="Hora" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label asp-for="IntervaloExecucao" class="label-custom">Intervalo</label>
                <input asp-for="IntervaloExecucao" type="time" class="form-input-custom" id="inputIntervalo" />
                <span asp-validation-for="IntervaloExecucao" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label asp-for="Dosagem" class="label-custom">Dosagem</label>
                <input asp-for="Dosagem" type="number" min="1" class="form-input-custom" id="inputDosagem" placeholder="1" />
                <span asp-validation-for="Dosagem" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label asp-for="Unidade" class="label-custom">Unidade</label>
                <select asp-for="Unidade" class="form-input-custom" id="inputUnidade">
                    <option value="" disabled selected hidden>Selecionar</option>
                    <option value="ML">Mililitro (mL)</option>
                    <option value="MG">Miligrama (mg)</option>
                    <option value="G">Gramas (g)</option>
                    <option value="UI">Unidades (UI)</option>
                </select>
                <span asp-validation-for="Unidade" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="col-12 col-md-4">
                <label class="label-custom d-block">Dias da semana</label>
                <div class="dias-semana-container">
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="SEG"> Seg</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="TER"> Ter</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="QUA"> Qua</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="QUI"> Qui</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="SEX"> Sex</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="SAB"> Sab</label>
                    <label class="dia-checkbox-label"><input type="checkbox" class="chk-dia" value="DOM"> Dom</label>
                </div>
                <span asp-validation-for="DiaSemana" class="text-danger d-block mt-1" style="font-size: 13px;"></span>
            </div>
        </div>
    </div>

    <div class="actions-container actions-container-planejamento d-flex flex-column flex-sm-row justify-content-end gap-2">
        <a asp-action="Index" class="btn-med btn-med-danger text-center" style="text-decoration: none;">Cancelar</a>
        <button type="submit" id="btnSalvarEdit" class="btn-med btn-med-primary">Salvar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        const mapaPosicionalDias = [
            { sigla: 'DOM', letra: 'D' },
            { sigla: 'SEG', letra: 'S' },
            { sigla: 'TER', letra: 'T' },
            { sigla: 'QUA', letra: 'Q' },
            { sigla: 'QUI', letra: 'Q' },
            { sigla: 'SEX', letra: 'S' },
            { sigla: 'SAB', letra: 'S' }
        ];

        function coletarDiasSemana() {
            const mascara = mapaPosicionalDias.map(dia => {
                const checkbox = document.querySelector(`.chk-dia[value='${dia.sigla}']`);
                return (checkbox && checkbox.checked) ? dia.letra : 'X';
            }).join('');

            const temAoMenosUmDia = mascara.split('').some(c => c !== 'X');
            document.getElementById('DiaSemana').value = temAoMenosUmDia ? mascara : '';
        }

        function restaurarDiasSemana() {
            const mascara = document.getElementById('DiaSemana').value;
            if (!mascara || mascara.length !== 7) return;

            mapaPosicionalDias.forEach((dia, index) => {
                const checkbox = document.querySelector(`.chk-dia[value='${dia.sigla}']`);
                if (checkbox) {
                    checkbox.checked = mascara[index] !== 'X';
                }
            });
        }

        function toggleContinuo(isContinuo) {
            const dataFimInput = document.getElementById('inputDataFim');
            const txtContinuo = document.getElementById('txtContinuo');
            const hiddenContinuo = document.getElementById('ContinuoHidden');
            const valDataFim = document.getElementById('valDataFim');

            hiddenContinuo.value = isContinuo ? "true" : "false";

            if (isContinuo) {
                txtContinuo.innerText = "Sim";
                dataFimInput.value = '9999-12-31';
                dataFimInput.disabled = true;
                dataFimInput.style.backgroundColor = '#e9ecef';
                if (valDataFim) valDataFim.innerText = '';
            } else {
                txtContinuo.innerText = "Não";
                if (dataFimInput.value === '9999-12-31') {
                    dataFimInput.value = '';
                }
                dataFimInput.disabled = false;
                dataFimInput.style.backgroundColor = '';
            }
        }

        $(document).ready(function () {
            $('#inputMedicamento').select2({
                placeholder: "Selecione um medicamento",
                allowClear: true,
                width: '100%'
            });

            restaurarDiasSemana();

            $(document).on('change', '.chk-dia', function () {
                coletarDiasSemana();
            });

            const switchContinuo = document.getElementById('switchContinuo');
            if (switchContinuo) {
                toggleContinuo(switchContinuo.checked);
                switchContinuo.addEventListener('change', function () {
                    toggleContinuo(this.checked);
                });
            }

            $('#formPlanejamentoEdit').on('submit', function () {
                coletarDiasSemana();
                const dataFimInput = document.getElementById('inputDataFim');
                if (dataFimInput && dataFimInput.disabled) {
                    dataFimInput.disabled = false;
                }
            });
        });
    </script>
}