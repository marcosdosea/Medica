@model Core.Dto.Planejamento.PlanejamentoDetailsDto
@using Util

@{
    ViewData["Title"] = "Detalhes do planejamento";
    var isContinuo = Model.DataFim.Year > 9000;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/formPaciente.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form/formPlanejamento.css" asp-append-version="true" />
}

<div class="header-inline mb-4 d-flex align-items-center gap-3">
    <a asp-action="Index" class="btn-voltar">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h2 style="margin: 0; font-weight: bold; font-size: 26px;">Detalhes do planejamento</h2>
</div>

<div id="detailsPlanejamentoContainer">
    <div class="secao-header mb-3" style="border:none; display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-person-fill" style="color: var(--text-muted); font-size: 20px;"></i>
        <span style="font-weight: 700; color: #495057; font-size: 18px;">Pacientes</span>
    </div>

    <div class="cards-grid mb-4">
        <div class="paciente-card-wrapper">
            <div class="paciente-card" style="cursor: default;">
                <div class="foto-wrapper">
                    <i class="bi bi-person" style="font-size: 48px; color: var(--text-muted);"></i>
                </div>
                <div class="paciente-info">
                    <h3 class="paciente-nome" title="@Model.NomePaciente">
                        @PacienteHelper.FormatarPrimeiroEUltimoNome(Model.NomePaciente)
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="secao-header mb-3" style="border:none; display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-calendar3" style="color: var(--text-muted); font-size: 18px;"></i>
        <span style="font-weight: 700; color: #495057; font-size: 18px;">Dados do planejamento</span>
    </div>

    <div class="form-section mb-4">
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-3 form-group-custom">
                <label class="label-custom">Medicamento</label>
                <div class="details-static-input font-bold">@Model.NomeMedicamento</div>
            </div>

            <div class="col-12 col-md-3 form-group-custom">
                <label class="label-custom">Apelido do medicamento</label>
                <div class="details-static-input">@(string.IsNullOrWhiteSpace(Model.ApelidoMedicamento) ? "" : Model.ApelidoMedicamento)</div>
            </div>

            <div class="col-12 col-md-3 form-group-custom">
                <label class="label-custom">Data de início</label>
                <div class="details-static-input">@Model.DataInicio.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="col-12 col-md-3 form-group-custom">
                <label class="label-custom">Data de fim</label>
                <div class="details-static-input">@(isContinuo ? "Contínuo" : Model.DataFim.ToString("dd/MM/yyyy"))</div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-2 form-group-custom">
                <label class="label-custom">Hora de início</label>
                <div class="details-static-input text-center">@Model.Hora.ToString(@"hh\:mm")</div>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label class="label-custom">Intervalo</label>
                <div class="details-static-input text-center">
                    @($"{(int)Model.IntervaloExecucao.TotalHours:D2}:{Model.IntervaloExecucao.Minutes:D2}")
                </div>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label class="label-custom">Dosagem</label>
                <div class="details-static-input text-center">@Model.Dosagem</div>
            </div>

            <div class="col-12 col-md-2 form-group-custom">
                <label class="label-custom">Unidade</label>
                <div class="details-static-input">@Html.DisplayFor(model => model.Unidade)</div>
            </div>

            <div class="col-12 col-md-4">
                <label class="label-custom d-block">Dias da semana</label>
                <div class="dias-semana-container">
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[1] != 'X' ? "checked" : "")> Seg
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[2] != 'X' ? "checked" : "")> Ter
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[3] != 'X' ? "checked" : "")> Qua
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[4] != 'X' ? "checked" : "")> Qui
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[5] != 'X' ? "checked" : "")> Sex
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[6] != 'X' ? "checked" : "")> Sab
                    </label>
                    <label class="dia-checkbox-label disabled">
                        <input type="checkbox" class="chk-dia" disabled @(Model.DiaSemana.Length == 7 && Model.DiaSemana[0] != 'X' ? "checked" : "")> Dom
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="secao-header mb-3" style="border:none; display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-clock-history" style="color: var(--text-muted); font-size: 18px;"></i>
        <span style="font-weight: 700; color: #495057; font-size: 18px;">
            Histórico de Execuções
        </span>
    </div>

    <div class="calendario-container mt-3 table-responsive" style="padding: 0; margin-bottom: 25px;">
        <table id="tabelaExecucoes" class="custom-table" style="width: 100%;">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Horário de Confirmação</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Execucoes != null && Model.Execucoes.Any())
                {
                    foreach (var execucao in Model.Execucoes)
                    {
                        <tr>
                            <td class="font-bold">@execucao.DataConfirmacao</td>
                            <td>@(string.IsNullOrWhiteSpace(execucao.HoraConfirmacao) ? "Não possui" : execucao.HoraConfirmacao)</td>
                            <td>@Html.DisplayFor(modelItem => execucao.Status)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="actions-container actions-container-planejamento d-flex flex-column flex-sm-row justify-content-end align-items-center gap-2">
        @if (Model.Status == Core.Enum.Planejamento.Status.CONCLUIDO)
        {
            <span class="badge bg-info text-dark px-3 py-2 fs-6 d-inline-flex align-items-center" style="font-weight: 600; height: 42px;">
                Planejamento Concluído
            </span>
        }
        else if (Model.Ativo == "N")
        {
            <span class="badge bg-secondary text-white px-3 py-2 fs-6 d-inline-flex align-items-center" style="font-weight: 600; height: 42px;">
                Planejamento Interrompido
            </span>

            <form asp-action="Activate" asp-route-id="@Model.Id" method="post" style="display: inline-flex; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-med btn-med-success">
                    Reativar
                </button>
            </form>
        }
        else
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline-flex; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-med btn-med-danger btn-excluir" data-nome="este planejamento">
                    Excluir
                </button>
            </form>

            @if (Model.Status == Core.Enum.Planejamento.Status.NAO_INICIADO)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-med btn-med-primary">Editar</a>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tabelaExecucoes').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json",
                    "emptyTable": "Nenhuma execução registrada para este planejamento"
                },
                "lengthMenu": [5, 10, 15],
                "pageLength": 5,
                "searching": false,
                "info": false,
                "dom": 'rt<"bottom d-flex justify-content-between align-items-center p-3 mt-2"lp><"clear">',
                "columnDefs": [
                    { "width": "35%", "targets": 0 },
                    { "width": "35%", "targets": 1 },
                    { "width": "30%", "targets": 2 }
                ]
            });
        });
    </script>
}