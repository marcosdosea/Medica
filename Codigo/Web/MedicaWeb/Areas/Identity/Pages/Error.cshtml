@page
@model ErrorModel
@{
    ViewData["Title"] = "Ops! Ocorreu um erro";
    Layout = "/Views/Shared/_LayoutIdentity.cshtml";
}

<div class="login-wrapper">
    <div class="login-box text-center">
        <div class="login-logo mb-3">
            <img src="~/img/logo.svg" alt="Logo" />
        </div>

        <div class="mb-4">
            <i class="bi bi-exclamation-circle-fill" style="font-size: 54px; color: #ffffff;"></i>
        </div>

        <h3 style="font-weight: 700; font-size: 24px; color: #ffffff; margin-bottom: 12px;">Ops! Ocorreu um erro</h3>
        
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
            Não foi possível concluir sua solicitação no momento.<br>
            Por favor, tente novamente mais tarde ou retorne à tela inicial.
        </p>


        <div class="d-flex flex-column gap-2 mt-4">
            <a asp-page="./Account/Login" class="btn-login" style="display: block; text-decoration: none; line-height: 40px; margin: 0;">VOLTAR PARA O LOGIN</a>
        </div>
    </div>
</div>