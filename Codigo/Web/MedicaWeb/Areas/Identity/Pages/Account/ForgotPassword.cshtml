@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueceu a senha";
}

<div class="login-wrapper">
    <div class="login-box">

        <div class="login-logo">
            <img src="~/img/logo.png" alt="Logo" />
        </div>

        <h4 style="font-weight: 700; color: #ffffff; margin-bottom: 10px;">Recuperar Senha</h4>
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 14px; margin-bottom: 25px; line-height: 1.5;">
            Informe o e-mail cadastrado na sua conta para receber o link de redefinição de senha.
        </p>

        <form id="forgot-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 validation-summary-box" role="alert"></div>

            <div class="custom-input-group">
                <svg viewBox="0 0 24 24">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input asp-for="Input.Email" class="custom-input" autocomplete="username" aria-required="true" placeholder="E-MAIL" />
            </div>
            <span asp-validation-for="Input.Email" class="text-warning text-start d-block mb-2 validation-error-text"></span>

            <button id="forgot-submit" type="submit" class="btn-login">ENVIAR LINK</button>

            <div class="login-links">
                <a asp-page="./Login">Lembrou a senha? Voltar ao login</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_Notificacoes" />
    <script>
        $('#forgot-password-form').on('submit', function () {
            if ($(this).valid()) {
                var btn = $('#forgot-submit');
                btn.css('pointer-events', 'none').css('opacity', '0.7').text('ENVIANDO...');
                setTimeout(function () {
                    btn.prop('disabled', true);
                }, 10);
            }
        });
    </script>
}
