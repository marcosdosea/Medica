@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "E-mail Confirmado";
    Layout = "/Views/Shared/_LayoutIdentity.cshtml";
}

<div class="login-wrapper">
    <div class="login-box text-center">
        <div class="login-logo mb-3">
            <img src="~/img/logo.svg" alt="Logo" />
        </div>

        <div class="mb-4">
            <i class="bi bi-patch-check-fill" style="font-size: 54px; color: #28a745;"></i>
        </div>

        <h3 style="font-weight: 700; font-size: 24px; color: #ffffff; margin-bottom: 12px;">Conta Confirmada!</h3>

        <div class="alert alert-success py-3 my-3" style="font-size: 14px;">
            @Model.StatusMessage
        </div>

        <div class="mt-4">
            <a asp-page="./Login" 
               class="btn btn-light w-100 d-flex align-items-center justify-content-center text-primary fw-bold" 
               style="height: 48px; border-radius: 8px; text-decoration: none; font-size: 14px; letter-spacing: 0.5px;">
                LOGIN
            </a>
        </div>
    </div>
</div>
