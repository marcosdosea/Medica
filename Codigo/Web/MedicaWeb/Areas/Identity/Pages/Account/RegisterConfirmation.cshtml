@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação de Conta";
    Layout = "/Views/Shared/_LayoutIdentity.cshtml";
}

<div class="login-wrapper">
    <div class="login-box text-center">
        <div class="login-logo mb-3">
            <img src="~/img/logo.png" alt="Logo" />
        </div>

        <div class="mb-4">
            <i class="bi bi-envelope-check-fill" style="font-size: 54px; color: #ffffff;"></i>
        </div>

        <h3 style="font-weight: 700; font-size: 24px; color: #ffffff; margin-bottom: 12px;">Confirme seu E-mail</h3>
        
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
            Enviamos um link de confirmação para:<br>
            <strong style="color: #ffffff; font-size: 16px; text-decoration: underline;">@Model.Email</strong><br><br>
            Por favor, verifique sua caixa de entrada (ou pasta de spam) e clique no botão para ativar sua conta.
        </p>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success py-2 mb-3" style="font-size: 13px; border-radius: 8px;">
                @TempData["MensagemSucesso"]
            </div>
        }

        <div class="d-flex flex-column gap-3 mt-4 w-100">
            <a asp-page="./Login" 
               class="btn btn-light w-100 d-flex align-items-center justify-content-center text-primary fw-bold" 
               style="height: 48px; border-radius: 8px; text-decoration: none; font-size: 14px; letter-spacing: 0.5px;">
                LOGIN
            </a>

            <form method="post" asp-page-handler="Resend" asp-route-email="@Model.Email" class="w-100 m-0">
                <button type="submit" 
                        class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center fw-bold" 
                        style="height: 48px; border-radius: 8px; border-width: 2px; font-size: 14px; letter-spacing: 0.5px;">
                    REENVIAR E-MAIL
                </button>
            </form>
        </div>

        <div class="mt-4">
            <p style="color: rgba(255, 255, 255, 0.7); font-size: 13px; margin: 0;">
                Não conseguiu? Não se preocupe, tente <a asp-page="./Register" style="color: #ffffff; text-decoration: underline; font-weight: 600;">registrar-se novamente</a>.
            </p>
        </div>
    </div>
</div>

