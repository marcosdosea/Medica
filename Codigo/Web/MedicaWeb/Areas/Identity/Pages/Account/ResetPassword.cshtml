@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir Senha";
}

<div class="login-wrapper">
    <div class="login-box">

        <div class="login-logo">
            <img src="~/img/logo.png" alt="Logo" />
        </div>

        <h4 style="font-weight: 700; color: #ffffff; margin-bottom: 10px;">Nova Senha</h4>
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 14px; margin-bottom: 20px;">
            Crie uma nova senha de acesso para sua conta.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 validation-summary-box" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="custom-input-group">
                <svg viewBox="0 0 24 24">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input asp-for="Input.Email" class="custom-input" autocomplete="username" aria-required="true" placeholder="E-MAIL" />
            </div>
            <span asp-validation-for="Input.Email" class="text-warning text-start d-block mb-2 validation-error-text"></span>

            <div class="custom-input-group">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input asp-for="Input.Password" type="password" class="custom-input" autocomplete="new-password" aria-required="true" placeholder="NOVA SENHA" />
            </div>
            <span asp-validation-for="Input.Password" class="text-warning text-start d-block mb-2 validation-error-text"></span>

            <div class="custom-input-group">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input asp-for="Input.ConfirmPassword" type="password" class="custom-input" autocomplete="new-password" aria-required="true" placeholder="CONFIRMAR NOVA SENHA" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-warning text-start d-block mb-2 validation-error-text"></span>

            <button type="submit" class="btn-login">SALVAR NOVA SENHA</button>

            <div class="login-links">
                <a asp-page="./Login">Voltar ao login</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_Notificacoes" />
}
