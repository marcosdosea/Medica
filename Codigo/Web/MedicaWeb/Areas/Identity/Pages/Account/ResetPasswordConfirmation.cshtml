@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Senha Atualizada";
    Layout = "/Views/Shared/_LayoutIdentity.cshtml";
}

<div class="login-wrapper">
    <div class="login-box text-center">
        <div class="login-logo mb-3">
            <img src="~/img/logo.png" alt="Logo" />
        </div>

        <div class="mb-4">
            <i class="bi bi-check-circle-fill" style="font-size: 54px; color: #ffffff;"></i>
        </div>

        <h3 style="font-weight: 700; font-size: 24px; color: #ffffff; margin-bottom: 12px;">Senha Atualizada!</h3>
        
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
            Sua senha foi redefinida com sucesso.<br>
            Você já pode acessar sua conta com a nova senha cadastrada.
        </p>

        <a asp-page="./Login" class="btn-login" style="display: block; text-decoration: none; line-height: 40px; margin: 0;">IR PARA O LOGIN</a>
    </div>
</div>
