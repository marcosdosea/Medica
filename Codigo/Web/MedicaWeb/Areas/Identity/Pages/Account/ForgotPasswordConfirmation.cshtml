@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "E-mail Enviado";
    Layout = "/Views/Shared/_LayoutIdentity.cshtml";
}

<div class="login-wrapper">
    <div class="login-box text-center">
        <div class="login-logo mb-3">
            <img src="~/img/logo.png" alt="Logo" />
        </div>

        <div class="mb-4">
            <i class="bi bi-envelope-check-fill" style="font-size: 54px; color: #ffffff;"></i>
        </div>

        <h3 style="font-weight: 700; font-size: 24px; color: #ffffff; margin-bottom: 12px;">E-mail Enviado!</h3>
        
        <p style="color: rgba(255, 255, 255, 0.85); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
            Se o endereço informado estiver cadastrado em nossa base, enviamos um e-mail com o link para redefinição de senha.<br><br>
            Verifique sua caixa de entrada e a pasta de spam.
        </p>

        <div class="d-flex flex-column gap-2 mt-4">
            <a asp-page="./Login" 
               class="btn btn-light w-100 d-flex align-items-center justify-content-center text-primary fw-bold" 
               style="height: 48px; border-radius: 8px; text-decoration: none; font-size: 14px; letter-spacing: 0.5px;">
                LOGIN
            </a>
            <a asp-page="./ForgotPassword" class="btn btn-outline-light w-100" style="font-weight: 600; padding: 10px; border-radius: 8px; border-width: 2px;">
                <i class="bi bi-arrow-repeat me-1"></i> TENTAR OUTRO E-MAIL
            </a>
        </div>
    </div>
</div>
